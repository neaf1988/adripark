# Modelo de Datos (Dexie.js)

## Tablas e Interfaces

```typescript
export interface Rate {
  id: string;
  vehicleType: string; // 'carro' | 'moto' | 'moto-grande'
  costPerMinute: number;
}

export interface Ticket {
  id?: number; // Auto-incremental
  plate: string; // Placa (indexado para búsquedas)
  vehicleType: 'Carro' | 'Moto' | 'Moto Grande';
  checkInTime: string; // ISO String
  checkOutTime: string | null;
  notes?: string;
  photos?: string[]; // Base64
  // Especificos de Motos (Moto y Moto Grande)
  helmetsCount?: number; // 0, 1, 2
  intercomCount?: number; // 0, 1, 2
  glovesCount?: number; // 0, 1, 2
  otherAccessories?: string;
  stayUnlocked?: boolean; // ¿Queda desbloqueada? (default true)
  // Especificos de Carro
  keysLeft?: boolean; // ¿Dejaron llaves? (default false)
  // Estado y Cobro
  status: 'PARKED' | 'COMPLETED' | 'CANCELLED';
  totalMinutes?: number;
  totalAmount?: number; // Monto final cobrado (puede diferir del calculado por descuento/propina)
}
```
